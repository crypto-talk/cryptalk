MYSQL_DATABASE=cryptalk
MYSQL_USER=cryptalk
MYSQL_PASSWORD=replace-with-a-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-password
JWT_SECRET=replace-with-at-least-32-random-bytes

# Public origin served by the gateway. Do not include a trailing slash.
PUBLIC_ORIGIN=http://localhost
HTTP_PORT=80

# Enable these for real ETH balance verification.
ETHEREUM_RPC_URL=
ETH_KRW_PRICE=0

# Set true only when PUBLIC_ORIGIN uses HTTPS.
AUTH_COOKIE_SECURE=false
